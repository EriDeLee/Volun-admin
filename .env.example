# Configuration reference: export these variables before starting (not auto-loaded).
APP_ENV=dev
HTTP_ADDR=:8080
DB_DRIVER=sqlite
SQLITE_PATH=data/volun-data.db
# Production: APP_ENV=prod, DB_DRIVER=postgres, DATABASE_URL required.
DATABASE_URL=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s

